<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GWAS Report — {{ trait_col }}</title>
<style>
  :root {
    --blue: #0072B2;
    --orange: #E69F00;
    --green: #009E73;
    --red: #D55E00;
    --purple: #CC79A7;
    --bg: #fafafa;
    --border: #ddd;
  }
  * { box-sizing: border-box; }
  body {
    font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 40px;
    background: #fff;
    color: #333;
    line-height: 1.6;
  }
  h1 { color: var(--blue); border-bottom: 3px solid var(--blue); padding-bottom: 8px; }
  h2 { color: #444; border-bottom: 1px solid var(--border); padding-bottom: 4px; margin-top: 2em; }
  h3 { color: #555; }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    margin: 16px 0;
  }
  .summary-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    text-align: center;
  }
  .summary-card .value {
    font-size: 1.8em;
    font-weight: 700;
    color: var(--blue);
  }
  .summary-card .label {
    font-size: 0.9em;
    color: #666;
    margin-top: 4px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 12px 0;
    font-size: 0.9em;
  }
  th, td {
    border: 1px solid var(--border);
    padding: 8px 12px;
    text-align: left;
  }
  th { background: var(--bg); font-weight: 600; }
  tr:nth-child(even) { background: #f9f9f9; }
  .figure-container {
    text-align: center;
    margin: 20px 0;
  }
  .figure-container img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .figure-caption {
    font-size: 0.85em;
    color: #666;
    margin-top: 6px;
    font-style: italic;
  }
  .metadata {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85em;
    white-space: pre-wrap;
    overflow-x: auto;
  }
  .footer {
    margin-top: 40px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 0.8em;
    color: #999;
    text-align: center;
  }
  @media print {
    body { max-width: 100%; padding: 10px; }
    .figure-container img { max-width: 80%; }
  }
</style>
</head>
<body>

<h1>GWAS Report: {{ trait_col }}</h1>
<p><strong>Generated:</strong> {{ date }} &nbsp;|&nbsp; <strong>Framework:</strong> TRACE v1.0.0</p>

<!-- ── Executive Summary ─────────────────────────── -->
<h2>Executive Summary</h2>
<div class="summary-grid">
  <div class="summary-card">
    <div class="value">{{ n_samples }}</div>
    <div class="label">Samples</div>
  </div>
  <div class="summary-card">
    <div class="value">{{ n_snps }}</div>
    <div class="label">SNPs (post-QC)</div>
  </div>
  {% if lambda_gc is not none %}
  <div class="summary-card">
    <div class="value">{{ "%.3f"|format(lambda_gc) }}</div>
    <div class="label">&lambda;<sub>GC</sub></div>
  </div>
  {% endif %}
  <div class="summary-card">
    <div class="value">{{ n_significant }}</div>
    <div class="label">Significant ({{ sig_label }})</div>
  </div>
</div>

<!-- ── QC Summary ────────────────────────────────── -->
<h2>Quality Control Summary</h2>
<table>
  <tr><th>Metric</th><th>Value</th></tr>
  {% for key, val in qc_snp.items() %}
  <tr><td>{{ key }}</td><td>{{ val }}</td></tr>
  {% endfor %}
</table>
{% if info_field %}
<p><strong>Imputation quality field detected:</strong> {{ info_field }}</p>
{% endif %}

<!-- ── Figures ────────────────────────────────────── -->
{% for fig_name, fig_b64 in figures.items() %}
<h2>{{ fig_name | replace("_", " ") | replace(".png", "") }}</h2>
<div class="figure-container">
  <img src="data:image/png;base64,{{ fig_b64 }}" alt="{{ fig_name }}">
</div>
{% endfor %}

<!-- ── Top Hits ───────────────────────────────────── -->
<h2>Top Hits</h2>
{% if top_hits_html %}
{{ top_hits_html | safe }}
{% else %}
<p>No significant hits at FDR &lt; 0.05.</p>
{% endif %}

<!-- ── PC-selection diagnostics ──────────────────── -->
{% if pc_selection_html %}
<h2>PC-selection diagnostics &mdash; eigenvalue spectrum</h2>
<p>Genotype-PCA eigenvalue spectrum (variance explained per PC and cumulative). Informational only &mdash; TRACE uses the fixed <code>--n-pcs</code> count and does not auto-select.</p>
{{ pc_selection_html | safe }}
{% endif %}

<!-- ── Significant SNPs (complete; T-20) ─────────────── -->
{% if significant_snps_html %}
<h2>Significant SNPs</h2>
<p>Every SNP passing the analysis significance threshold ({{ sig_label }}). Each row is
marked as belonging to an LD block or as <strong>unblocked</strong>, with its candidate
interval and gene evidence. This table is complete &mdash; no significant SNP is omitted.</p>
<div style="overflow-x:auto">{{ significant_snps_html | safe }}</div>
{% endif %}

<!-- ── Per-SNP effect plots (T-21) ───────────────────── -->
{% if snp_plots %}
<h2>Per-SNP effect plots</h2>
<p>Genotype-class phenotype distributions for the top significant SNPs. A box is
drawn only for classes with n&nbsp;&ge;&nbsp;5; the structure-adjusted &beta;<sub>MLM</sub>,
the raw-vs-adjusted effect flag, and the per-SNP &eta;<sup>2</sup> are annotated. Plots are
capped for report size &mdash; the significant-SNP table above is complete.</p>
<div style="display:flex;flex-wrap:wrap;gap:10px">
{% for p in snp_plots %}
<figure style="margin:0;text-align:center">
  <img src="data:image/png;base64,{{ p.b64 }}" alt="{{ p.snp }}" style="max-width:280px">
  <figcaption style="font-size:0.8em">{{ p.caption }}</figcaption>
</figure>
{% endfor %}
</div>
{% endif %}

<!-- ── Isolated significant SNPs (no LD block) ───────── -->
{% if isolated_intervals_html %}
<h2>Significant SNPs with no LD block</h2>
<p>Significant SNPs that formed no LD block, reported with a flanking-marker interval. Bounds are
the nearest typed post-QC markers; interval width reflects marker density, not association strength.
Genes are listed by physical position only, in genomic order.</p>
<div style="overflow-x:auto">{{ isolated_intervals_html | safe }}</div>
{% endif %}

{% if ld_blocks_html or ld_blocks_annotated_html or haplotype_gwas_html %}
<!-- ── Post-GWAS: LD blocks + annotation + haplotypes ── -->
<h2>Post-GWAS: LD Blocks &amp; Haplotypes</h2>
{% if ld_blocks_html %}<h3>LD blocks</h3><div style="overflow-x:auto">{{ ld_blocks_html | safe }}</div>{% endif %}
{% if ld_blocks_annotated_html %}<h3>Annotated LD blocks</h3><div style="overflow-x:auto">{{ ld_blocks_annotated_html | safe }}</div>{% endif %}
{% if haplotype_gwas_html %}<h3>Haplotype block GWAS</h3><div style="overflow-x:auto">{{ haplotype_gwas_html | safe }}</div>{% endif %}
{% endif %}

<!-- ── Per-model post-GWAS ───────────────────────────── -->
{% if model_sections %}
<h2>Per-model Post-GWAS</h2>
{% for section in model_sections %}
<h3>{{ section.name }}</h3>
{% if section.ld_annotated_html %}<div style="overflow-x:auto">{{ section.ld_annotated_html | safe }}</div>{% endif %}
{% if section.haplotype_html %}<div style="overflow-x:auto">{{ section.haplotype_html | safe }}</div>{% endif %}
{% endfor %}
{% endif %}

<!-- ── Multi-model summaries ─────────────────────────── -->
{% if mlmm_summary or farmcpu_summary %}
<h2>Multi-model Summaries</h2>
{% if mlmm_summary %}<h3>MLMM cofactors</h3><div style="overflow-x:auto">{{ mlmm_summary | safe }}</div>{% endif %}
{% if farmcpu_summary %}<h3>FarmCPU pseudo-QTNs</h3><div style="overflow-x:auto">{{ farmcpu_summary | safe }}</div>{% endif %}
{% endif %}

<!-- ── Metadata ───────────────────────────────────── -->
<h2>Run Metadata</h2>
<div class="metadata">{{ metadata_json | safe }}</div>

<div class="footer">
  Generated by TRACE &mdash; Trait Resolution and Candidate Evaluation
</div>

</body>
</html>
